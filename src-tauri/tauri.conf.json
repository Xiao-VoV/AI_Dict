{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "划词翻译",
  "version": "0.1.0",
  "identifier": "com.selection.translator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "划词翻译",
        "width": 960,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/dicts/*"
    ],
    "icon": []
  }
}
